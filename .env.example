#  MediAgent v5 — Environment Variables
#  Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════
>>>>>>> 82b3e2ae31d851bacf2297cc50268510f869a118

# Gemini API
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=35
GEMINI_MAX_OUTPUT_TOKENS=700

# Frontend URLs allowed to call the backend, comma-separated.
# Example for production:
# FRONTEND_ORIGINS=https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend-only env var for deployed React app.
# Set this in Vercel/Netlify to your backend API URL including /api.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Email - Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=MediAgent <your@gmail.com>

# WhatsApp - Twilio Sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Auto scheduled reminders
REMINDER_EMAIL=your@gmail.com
REMINDER_PHONE=+1234567890
